# =========================================================
# RetailOps AX — Environment Variables
# Copy this file to .env and fill in your local values.
# Never commit the real .env file.
# =========================================================

# Public Data Portal API
DATA_GO_KR_API_KEY=YOUR_DATA_GO_KR_API_KEY

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=retailops_ax
DB_USER=YOUR_DB_USER

# Leave blank if your local PostgreSQL user has no password.
DB_PASSWORD=

# Optional aliases supported by some scripts
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=retailops_ax
# POSTGRES_USER=YOUR_DB_USER
# POSTGRES_PASSWORD=
